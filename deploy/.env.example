# Скопируйте в .env и задайте свои значения
DB_PASSWORD=смените-пароль-бд
SECRET_KEY=длинная-случайная-строка-для-подписи-токенов
ADMIN_PASSWORD=admin
HTTP_PORT=8080

# HTTPS (Б-1): домен сервера; запуск — docker compose --profile https up -d
DOMAIN=flora.example.ru

# ключи внешних систем (заголовок X-API-Key)
SHOP_API_KEY=shop-demo-key
ONEC_API_KEY=1c-demo-key

# почта для отправки заказов поставщикам (пусто — письма кладутся в /data/outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=zakupki@floraplan.local

# адрес сайта для выгрузки остатков каждые 15 минут (пусто — сайт сам опрашивает API)
SHOP_WEBHOOK_URL=

# готовые образы из GitHub Container Registry вместо локальной сборки:
# IMAGE_PREFIX=ghcr.io/darkswordman999/flower-demand-planning
# TAG=1.0.0
