# backend-api и scheduler (один образ, разные команды)
FROM python:3.12-slim
# источник — репозиторий: по этой метке GitHub привязывает пакет в ghcr.io к репозиторию
LABEL org.opencontainers.image.source="https://github.com/DarkSwordman999/flower-demand-planning" \
      org.opencontainers.image.description="ФлораПлан: backend-api и планировщик"

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    FLORAPLAN_DATA_DIR=/data TZ=Europe/Moscow

RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/pyproject.toml ./
COPY backend/floraplan ./floraplan
RUN pip install .

RUN useradd -r -u 1000 flora && mkdir -p /data && chown flora /data
USER flora
VOLUME /data
EXPOSE 8000

# миграции применяются при старте; планировщик — отдельным сервисом (scheduler)
CMD ["sh", "-c", "floraplan init-db --admin-password \"${FLORAPLAN_ADMIN_PASSWORD:-admin}\" && exec uvicorn floraplan.main:app --host 0.0.0.0 --port 8000 --proxy-headers"]
