@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
skinparam componentStyle rectangle
actor "Флорист-\nкассир" as PF
actor "Владелец\nсалона" as DIR
rectangle "Компьютер салона (Windows)" as PC {
  rectangle "Веб-браузер" as UI
  rectangle "Программа «ФлораПлан Базовая»\n(Python, Flask)" as SRV {
    rectangle "Справочники товаров\nи поставщиков" as A
    rectangle "Учёт партий,\nостатков и списаний" as B
    rectangle "Продажи\nпо FEFO" as C
    rectangle "Прогноз спроса\n(скользящее среднее)" as D
    rectangle "Расчёт заказа\nпоставщику" as E
    rectangle "Отчёт за 30 дней" as G
  }
  database "Файл базы данных\nSQLite (floraplan.db)" as DB
}
rectangle "Поставщики" as SUP
PF --> UI
DIR --> UI
UI --> A
UI --> B
UI --> C
UI --> E
UI --> G
C --> D
D --> E
B --> E
A --> DB
B --> DB
C --> DB
DIR ..> SUP : заказ по телефону\nили почте (вручную)
@enduml
