@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam linetype ortho
entity "Товар" as tv {
 * id_товара
 --
 наименование, вид, сорт
 длина_стебля, цвет
 срок_реализации_дн
 кратность_упаковки
}
entity "Поставщик" as ps {
 * id_поставщика
 --
 наименование, страна
 срок_поставки_дн
 мин_сумма_заказа
}
entity "Условие_поставки" as up {
 * id_условия
 --
 id_товара (FK)
 id_поставщика (FK)
 цена, кратность
}
entity "Заказ_поставщику" as zp {
 * id_заказа
 --
 id_поставщика (FK)
 дата, ожидаемая_дата
 статус, сумма
}
entity "Строка_заказа" as sz {
 * id_строки
 --
 id_заказа (FK)
 id_товара (FK)
 рекоменд_кол-во
 заказ_кол-во, цена
}
entity "Место_хранения" as mh {
 * id_места
 --
 наименование
 тип (склад / салон)
}
entity "Партия" as pt {
 * id_партии
 --
 id_товара (FK)
 id_заказа (FK)
 id_места (FK)
 дата_поступления
 годен_до
 кол-во, остаток
 себестоимость
}
entity "Продажа" as pr {
 * id_продажи
 --
 id_места (FK)
 дата_время
 канал (салон / сайт)
}
entity "Строка_продажи" as sp {
 * id_строки
 --
 id_продажи (FK)
 id_партии (FK)
 кол-во, цена, скидка
}
entity "Списание" as sl {
 * id_списания
 --
 id_партии (FK)
 кол-во, причина, дата
}
entity "Прогноз" as fc {
 * id_прогноза
 --
 id_товара (FK)
 id_места (FK)
 id_модели (FK)
 дата, P50, P80, P95
}
entity "Модель_прогноза" as md {
 * id_модели
 --
 версия, алгоритм
 WAPE, статус
}
entity "Событие_календаря" as ev {
 * id_события
 --
 дата, наименование
 тип (праздник / акция)
}
ps ||--o{ up
tv ||--o{ up
ps ||--o{ zp
zp ||--|{ sz
tv ||--o{ sz
tv ||--o{ pt
zp ||--o{ pt
mh ||--o{ pt
mh ||--o{ pr
pr ||--|{ sp
pt ||--o{ sp
pt ||--o{ sl
tv ||--o{ fc
mh ||--o{ fc
md ||--o{ fc
@enduml
