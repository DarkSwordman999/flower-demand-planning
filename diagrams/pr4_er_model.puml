@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam linetype ortho
entity "users\nПользователь" as us {
 * id : INTEGER
 --
 login : TEXT (уник.)
 password_hash : TEXT
}
entity "suppliers\nПоставщик" as sp {
 * id : INTEGER
 --
 name : TEXT
 phone : TEXT
 lead_time_days : INTEGER
}
entity "products\nТовар" as pr {
 * id : INTEGER
 --
 name, category : TEXT
 price, purchase_price : REAL
 shelf_life_days : INTEGER
 pack_size : INTEGER
 supplier_id : INTEGER (FK)
}
entity "batches\nПартия" as bt {
 * id : INTEGER
 --
 product_id : INTEGER (FK)
 received_date : TEXT
 expiry_date : TEXT
 quantity, remaining : INTEGER
}
entity "sales\nПродажа" as sl {
 * id : INTEGER
 --
 product_id : INTEGER (FK)
 batch_id : INTEGER (FK)
 sale_date : TEXT
 quantity : INTEGER
 price : REAL
}
entity "writeoffs\nСписание" as wo {
 * id : INTEGER
 --
 batch_id : INTEGER (FK)
 writeoff_date : TEXT
 quantity : INTEGER
 reason : TEXT
}
sp |o--o{ pr
pr ||--o{ bt
pr ||--o{ sl
bt |o--o{ sl
bt ||--o{ wo
@enduml
