@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
start
:Получить заказ с сайта или из канала;
if (Номер заказа уже есть?) then (да)
  :Вернуть прежний заказ;
  stop
else (нет)
endif
if (Дата доставки прошла или количество ≤ 0?) then (да)
  :Отклонить заказ;
  stop
else (нет)
endif
if (Товара, годного на дату доставки, хватает?) then (да)
  :Создать заказ «Зарезервирован»;
  :Зарезервировать партии по FEFO;
else (нет)
  :Создать заказ «Предзаказ»;
  :Ждать поступления товара;
  :Зарезервировать при приёмке
  или перемещении;
endif
:Флорист собирает букет;
if (Заказ выполнен?) then (да)
  :Записать продажу из резерва;
  :Статус «Выполнен»;
else (отменён)
  :Снять резерв;
  :Статус «Отменён»;
endif
stop
@enduml
