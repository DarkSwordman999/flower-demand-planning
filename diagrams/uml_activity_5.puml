if (Поставщик успевает к дате?) then (нет)
  :Ошибка «Поставщик не успеет»;
  stop
else (да)
endif
if (Прогноз рассчитан?) then (нет)
  :Ошибка «Рассчитайте прогноз»;
  stop
else (да)
endif
:α = Cu / (Cu + Co);
while (Есть товар поставщика?) is (да)
  :D — квантиль α спроса до следующей поставки;
  :S — запас, который продастся до истечения срока;
  :Z — заказы в пути;
  :Q = max(0, D − S − Z), не больше продаж за срок;
  :Округлить до кратности упаковки;
endwhile (нет)
