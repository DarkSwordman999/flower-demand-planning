@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
|Кладовщик|
start
:Выбрать заказ «В пути» на ТСД;
repeat
  :Сканировать упаковку, ввести количество,
  брак, сокращение срока;
repeat while (Есть ещё позиции?) is (да)
-> нет;
:Завершить приёмку;
|Система|
:Проверить количества;
while (Есть строка заказа?) is (да)
  if (Импорт без фитосанитарных документов?) then (да)
    :Запретить приёмку позиции;
  else (нет)
    :Сверить с заказом;
    :Создать партию,
    годен до = дата + срок − сокращение;
  endif
endwhile (нет)
if (Есть расхождения?) then (да)
  :Создать акт расхождений;
else (нет)
endif
:Статус заказа «Принят»;
:Зарезервировать предзаказы;
|Кладовщик|
:Напечатать этикетки партий;
stop
@enduml
