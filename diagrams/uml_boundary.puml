@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam classAttributeIconSize 0
skinparam wrapWidth 260
class APIИнтернетМагазина <<boundary>> {
 +передатьЗаказ(...)
}
class КарточкаЗаказа <<boundary>> {
 +отправитьСогласование()
 +принятьРешениеЗаказу()
 +отправитьПоставщику()
 +отметитьПодтверждениеОтгрузку()
 +закрытьЗаказ()
}
class ФормаВхода <<boundary>> {
 +ввестиЛогинПароль()
 +сменитьПароль()
}
class ЭкранАдминистрирования <<boundary>> {
 +добавитьПользователя()
 +подключитьКаналПродаж()
 +изменитьПараметры()
 +открытьЖурналыДействий()
 +создатьСкачатьКопию()
}
class ЭкранЗапасов <<boundary>> {
 +указатьТовар()
 +открытьПартииМеста()
 +ввестиФактическоеКоличество()
 +провестиИнвентаризацию()
 +открытьПартииИстёкшим()
 +отметитьПартии()
}
class ЭкранОнлайнЗаказов <<boundary>> {
 +выполнитьЗаказ()
}
class ЭкранОтчётов <<boundary>> {
 +выбратьОтчёт()
 +выгрузитьXLSX()
}
class ЭкранПланаЗакупок <<boundary>> {
 +выбратьПоставщикаДату()
 +сформироватьЧерновик()
 +изменитьКоличество()
}
class ЭкранПриёмкиТСД <<boundary>> {
 +выбратьЗаказПути()
 +сканироватьШтрихкод()
 +завершитьПриёмку()
}
class ЭкранПрогноза <<boundary>> {
 +создатьВерсию()
 +опубликоватьВерсию()
}
class ЭкранПродаж <<boundary>> {
 +сканироватьТовары()
}
class ЭкранСправочников <<boundary>> {
 +добавитьГруппуТоваров()
 +заполнитьКарточкуТовара()
 +ввестиПоставщика()
 +задатьУсловиеПоставки()
 +добавитьСобытие()
 +создатьСценарийПраздника()
 +утвердитьСценарий()
}
class ЭкранСроков <<boundary>> {
 +открытьКонтрольСроков()
 +подтвердитьУценку()
}
APIИнтернетМагазина -[hidden]down- ЭкранАдминистрирования
КарточкаЗаказа -[hidden]down- ЭкранЗапасов
ФормаВхода -[hidden]down- ЭкранОнлайнЗаказов
ЭкранАдминистрирования -[hidden]down- ЭкранОтчётов
ЭкранЗапасов -[hidden]down- ЭкранПланаЗакупок
ЭкранОнлайнЗаказов -[hidden]down- ЭкранПриёмкиТСД
ЭкранОтчётов -[hidden]down- ЭкранПрогноза
ЭкранПланаЗакупок -[hidden]down- ЭкранПродаж
ЭкранПриёмкиТСД -[hidden]down- ЭкранСправочников
ЭкранПрогноза -[hidden]down- ЭкранСроков
@enduml
