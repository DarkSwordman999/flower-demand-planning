@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
hide members
left to right direction
skinparam linetype ortho
package "Граничные классы" {
 class ФормаВхода <<boundary>>
 class ЭкранСправочников <<boundary>>
 class ЭкранПрогноза <<boundary>>
 class ЭкранПланаЗакупок <<boundary>>
 class КарточкаЗаказа <<boundary>>
 class ЭкранПриёмкиТСД <<boundary>>
 class ЭкранЗапасов <<boundary>>
 class ЭкранПродаж <<boundary>>
 class ЭкранОнлайнЗаказов <<boundary>>
 class ЭкранСроков <<boundary>>
 class ЭкранОтчётов <<boundary>>
 class ЭкранАдминистрирования <<boundary>>
 class APIИнтернетМагазина <<boundary>>
}
package "Управляющие классы" {
 class СервисСправочников <<control>>
 class СервисПрогнозирования <<control>>
 class МоделиВременныхРядов <<control>>
 class СервисПланированияЗакупок <<control>>
 class АдаптерПоставщика <<control>>
 class КонтроллерПриёмки <<control>>
 class СервисЗапасов <<control>>
 class СервисПродаж <<control>>
 class АдаптерКасс <<control>>
 class СервисИнтернетМагазина <<control>>
 class СервисСроковИУценки <<control>>
 class СервисАналитики <<control>>
 class АдаптерПогоды <<control>>
 class ПланировщикЗадач <<control>>
}
package "Классы-сущности" {
 class Товар <<entity>>
 class Поставщик <<entity>>
 class УсловиеПоставки <<entity>>
 class ЗаказПоставщику <<entity>>
 class СтрокаЗаказа <<entity>>
 class Партия <<entity>>
 class ДвижениеЗапаса <<entity>>
 class Продажа <<entity>>
 class СтрокаПродажи <<entity>>
 class ОнлайнЗаказ <<entity>>
 class Резерв <<entity>>
 class Списание <<entity>>
 class Уценка <<entity>>
 class Прогноз <<entity>>
 class МодельПрогноза <<entity>>
 class МестоХранения <<entity>>
}
ЭкранСправочников --> СервисСправочников
ЭкранПрогноза --> СервисПрогнозирования
ЭкранПланаЗакупок --> СервисПланированияЗакупок
КарточкаЗаказа --> СервисПланированияЗакупок
ЭкранПриёмкиТСД --> КонтроллерПриёмки
ЭкранЗапасов --> СервисЗапасов
ЭкранПродаж --> СервисПродаж
ЭкранОнлайнЗаказов --> СервисИнтернетМагазина
APIИнтернетМагазина --> СервисИнтернетМагазина
ЭкранСроков --> СервисСроковИУценки
ЭкранОтчётов --> СервисАналитики
СервисПланированияЗакупок --> АдаптерПоставщика
СервисПрогнозирования --> МоделиВременныхРядов
СервисПрогнозирования --> АдаптерПогоды
АдаптерКасс --> СервисПродаж
СервисИнтернетМагазина --> СервисПродаж
КонтроллерПриёмки --> СервисИнтернетМагазина
ПланировщикЗадач --> СервисПрогнозирования
ПланировщикЗадач --> АдаптерКасс
Поставщик "1" -- "0..*" УсловиеПоставки
Товар "1" -- "0..*" УсловиеПоставки
Поставщик "1" -- "0..*" ЗаказПоставщику
ЗаказПоставщику "1" *-- "1..*" СтрокаЗаказа
СтрокаЗаказа "1" -- "0..*" Партия
Товар "1" -- "0..*" Партия
МестоХранения "1" -- "0..*" Партия
Партия "1" -- "0..*" ДвижениеЗапаса
Продажа "1" *-- "1..*" СтрокаПродажи
Партия "1" -- "0..*" СтрокаПродажи
Партия "1" -- "0..*" Списание
Партия "1" -- "0..*" Уценка
Партия "1" -- "0..*" Резерв
ОнлайнЗаказ "1" -- "0..*" Резерв
Товар "1" -- "0..*" Прогноз
МодельПрогноза "1" -- "0..*" Прогноз
СервисПланированияЗакупок --> ЗаказПоставщику
СервисЗапасов --> Партия
СервисПродаж --> Продажа
СервисПрогнозирования --> Прогноз
СервисИнтернетМагазина --> ОнлайнЗаказ
@enduml
