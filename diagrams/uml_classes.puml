@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
package "Шаблоны страниц (templates)" {
 class ФормаВхода <<boundary>>
 class ТаблицаОстатков <<boundary>>
 class ФормаПриёмки <<boundary>>
 class ФормаПродажи <<boundary>>
 class СправочникТоваров <<boundary>>
 class СправочникПоставщиков <<boundary>>
 class ТаблицаПрогноза <<boundary>>
 class ТаблицаЗаказа <<boundary>>
 class Отчёт <<boundary>>
}
package "Обработчики страниц (app.py)" {
 class Вход <<control>>
 class ОбработчикОстатков <<control>>
 class ОбработчикПриёмки <<control>>
 class ОбработчикПродаж <<control>>
 class ОбработчикСправочников <<control>>
 class ОбработчикПрогноза <<control>>
 class ОбработчикЗаказа <<control>>
 class ОбработчикОтчёта <<control>>
}
package "Правила (logic.py)" {
 class ПродажаFEFO <<control>>
 class КонтрольСроков <<control>>
 class ПрогнозСпроса <<control>>
 class РасчётЗаказа <<control>>
}
package "Данные (db.py, schema.sql)" {
 class Пользователь <<entity>> {
  логин
  хэшПароля
 }
 class Поставщик <<entity>> {
  срокПоставки
 }
 class Товар <<entity>> {
  цена, ценаЗакупки
  срокРеализации
  упаковка
 }
 class Партия <<entity>> {
  годенДо
  остаток
 }
 class Продажа <<entity>>
 class Списание <<entity>> {
  причина
 }
}
ФормаВхода --> Вход
ТаблицаОстатков --> ОбработчикОстатков
ФормаПриёмки --> ОбработчикПриёмки
ФормаПродажи --> ОбработчикПродаж
СправочникТоваров --> ОбработчикСправочников
СправочникПоставщиков --> ОбработчикСправочников
ТаблицаПрогноза --> ОбработчикПрогноза
ТаблицаЗаказа --> ОбработчикЗаказа
Отчёт --> ОбработчикОтчёта
Вход --> Пользователь
ОбработчикОстатков --> КонтрольСроков
ОбработчикОстатков --> Списание
ОбработчикПриёмки --> Партия
ОбработчикПродаж --> ПродажаFEFO
ОбработчикПрогноза --> ПрогнозСпроса
ОбработчикЗаказа --> РасчётЗаказа
РасчётЗаказа --> ПрогнозСпроса
ПродажаFEFO --> Партия
ПродажаFEFO --> Продажа
ОбработчикОтчёта --> Продажа
ОбработчикСправочников --> Товар
Поставщик "1" -- "0..*" Товар
Товар "1" -- "0..*" Партия
Партия "1" -- "0..*" Продажа
Партия "1" -- "0..*" Списание
@enduml
