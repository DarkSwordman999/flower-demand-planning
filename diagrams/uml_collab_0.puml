@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Сотрудник" as U
rectangle ":ФормаВхода\n«boundary»" as UI
rectangle ":КонтроллерВхода\n«control»" as C
rectangle ":Пользователь\n«entity»" as E
rectangle ":ЖурналАудита\n«entity»" as AU
U -- UI : "1: ввести логин и пароль ↓\n5: [не найден, заблокирован или\nпароль неверен] показать ошибку\n↑\n10: [пароль верен] главная\nстраница для роли ↑\n11: [смена пароля] сменить\nпароль ↓"
UI -- C : "2: получитьТокен(логин, пароль)\n↓\n4: [не найден, заблокирован или\nпароль неверен] 401 «Неверный\nлогин или пароль» ↑\n9: [пароль верен] токен, роль,\nсалон пользователя ↑\n12: [смена пароля]\nсменитьПароль(текущий, новый) ↓"
C -- E : "3: найти(логин) ↓\n13: [смена пароля]\nsetХэшПароля() [новый ≥ 6\nсимволов] ↓"
C -- C : "6: [пароль верен]\nпроверитьХэшПароля()\n7: [пароль верен]\nвыпуститьТокен(пользователь,\nроль, срок)"
C -- AU : "8: [пароль верен] записать(вход\nв систему) ↓"
@enduml
