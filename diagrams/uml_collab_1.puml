@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Менеджер по закупкам" as MZ
rectangle ":ЭкранСправочников\n«boundary»" as UI
rectangle ":СервисСправочников\n«control»" as S
rectangle ":ГруппаТоваров\n«entity»" as G
rectangle ":Товар\n«entity»" as T
rectangle ":Поставщик\n«entity»" as SP
rectangle ":УсловиеПоставки\n«entity»" as U
rectangle ":ЖурналАудита\n«entity»" as AU
MZ -- UI : "1: добавить группу товаров ↓\n4: заполнить карточку товара:\nвид, сорт, цвет, срок\nреализации, кратность, штрихкод,\nцена ↓\n10: ввести поставщика: страна,\nсрок поставки, мин. сумма, дни\nзаказа, способ отправки ↓\n14: задать условие поставки:\nтовар, цена, кратность упаковки\n↓"
UI -- S : "2: создатьГруппу(название) ↓\n5: создатьТовар(данные) ↓\n8: [такая запись уже есть]\n«Запись с такими данными уже\nсуществует» ↑\n11: создатьПоставщика(данные) ↓\n15: создатьУсловие(поставщик,\nтовар, цена, кратность) ↓\n17: [условие уже есть] «Условие\nдля этого товара уже задано» ↑"
S -- G : "3: создать() [название\nуникально] ↓"
S -- S : "6: проверитьКарточку() [срок ≥ 1\nдн., кратность ≥ 1, цена ≥ 0]\n12: проверитьСпособ() [email —\nадрес почты, api — адрес API;\nдни 0–6]"
S -- T : "7: найти(штрихкод, название) ↓\n9: [данные корректны] создать()\n↓"
S -- SP : "13: создать() ↓"
S -- U : "16: найти(поставщик, товар) ↓\n18: [новое] создать() ↓"
S -- AU : "19: записать(изменение\nсправочника) ↓"
@enduml
