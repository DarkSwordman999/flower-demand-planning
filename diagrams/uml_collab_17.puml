@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Администратор" as AD
rectangle ":ЭкранАдминистрирования\n«boundary»" as UI
rectangle ":СервисАдминистрирования\n«control»" as S
rectangle ":Пользователь\n«entity»" as E
rectangle ":КаналПродаж\n«entity»" as CH
rectangle ":Параметр\n«entity»" as PS
rectangle ":ЖурналАудита\n«entity»" as AU
rectangle ":СервисРезервногоКопирования\n«control»" as B
actor "Время" as TM
rectangle ":ПланировщикЗадач\n«control»" as SCH
AD -- UI : "1: добавить пользователя: логин,\nФИО, роль, салон, пароль ↓\n5: подключить канал продаж: код,\nместо, коэффициент цены ↓\n9: изменить параметры: бюджет\nнедели, порог расхождений,\nскидки, горизонт прогноза ↓\n13: открыть журналы действий и\nобмена ↓\n18: создать или скачать копию ↓"
UI -- S : "2: создатьПользователя(данные) ↓\n6: подключитьКанал(данные) ↓\n10: сохранитьПараметры(значения)\n↓\n14: журналы(отбор) ↓"
S -- S : "3: проверить() [роль, уникальный\nлогин, пароль ≥ 6]\n7: новыйКлюч() [показывается\nодин раз]"
S -- E : "4: создать() ↓"
S -- CH : "8: создать(SHA-256 ключа, место,\nкоэффициент) ↓"
S -- PS : "11: setЗначение() [проверка\nдиапазонов] ↓"
S -- AU : "12: записать(изменения) ↓\n15: выбрать(отбор) ↓"
TM -- SCH : "16: резервнаяКопия() [ежедневно\n02:00] ↓"
B -- SCH : "17: создатьКопию() ↑"
UI -- B : "19: создатьКопию() ↓"
@enduml
