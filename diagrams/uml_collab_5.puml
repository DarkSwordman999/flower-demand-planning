@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Менеджер по закупкам" as MZ
rectangle ":ЭкранПланаЗакупок\n«boundary»" as UI
rectangle ":СервисПланированияЗакупок\n«control»" as S
rectangle ":Поставщик\n«entity»" as SP
rectangle ":УсловиеПоставки\n«entity»" as U
rectangle ":Прогноз\n«entity»" as F
rectangle ":Партия\n«entity»" as P
rectangle ":СценарийПраздника\n«entity»" as SC
rectangle ":СтрокаЗаказа\n«entity»" as L
rectangle ":ЗаказПоставщику\n«entity»" as Z
MZ -- UI : "1: выбрать поставщика и дату\nзаказа ↓\n17: сформировать черновик ↓\n20: изменить количество, указать\nпричину ↓"
UI -- S : "2: рассчитатьПлан(поставщик,\nдата) ↓\n16: рекомендуемый заказ с\nобоснованием ↑\n18: создатьЗаказ(план) ↓\n21: изменитьСтроки(заказ,\nпозиции) ↓"
S -- SP : "3: графикИСрок() ↓"
S -- S : "4: ближайшаяПоставка() [день\nзаказа + срок поставки]\n7: уровеньОбслуживания() [α = Cu\n/ (Cu + Co)]\n9: [для каждого товара\nпоставщика] квантильСпроса(α)\n[D]\n12: [для каждого товара\nпоставщика] объём() [Q = max(0,\nD − S − Z), не больше продаж за\nсрок]\n13: [для каждого товара\nпоставщика]\nокруглитьДоКратности()\n14: [сумма меньше минимальной\nсуммы поставщика]\nдозаказатьГруппуA()\n15: [превышен бюджет недели]\nсократитьПоABC() [сначала C,\nзатем B]\n22: проверитьКратность()\n[причина при отклонении > 30 %]"
S -- U : "5: условия(поставщик) ↓"
S -- F : "6: p50(товары, период) [до\nследующей поставки] ↓"
S -- SC : "8: [утверждённый сценарий\nпраздника в периоде]\nкоэффициенты(группы) [в дни пика\nвместо календарных] ↓"
S -- P : "10: [для каждого товара\nпоставщика]\nзапасДоИстеченияСрока() [S, FEFO\nпо прогнозу] ↓"
S -- L : "11: [для каждого товара\nпоставщика] заказыВПути() [Z] ↓"
S -- Z : "19: создать(статус = черновик,\nстроки) ↓\n23: пересчитатьСумму() ↓"
@enduml
