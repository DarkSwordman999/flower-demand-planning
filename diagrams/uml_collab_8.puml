@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Кладовщик" as KL
rectangle ":ЭкранПриёмкиТСД\n«boundary»" as UI
rectangle ":КонтроллерПриёмки\n«control»" as C
rectangle ":ЗаказПоставщику\n«entity»" as Z
rectangle ":Партия\n«entity»" as P
rectangle ":ДвижениеЗапаса\n«entity»" as M
rectangle ":АктРасхождений\n«entity»" as A
rectangle ":СервисИнтернетМагазина\n«control»" as SH
KL -- UI : "1: выбрать заказ «в пути» ↓\n4: [для каждой позиции]\nсканировать штрихкод, ввести\nпоступило, брак, сокращение\nсрока, документы ↓\n5: завершить приёмку ↓"
UI -- C : "2: заказыКПриёмке() ↓\n6: принять(заказ, позиции) ↓\n15: партии, акт расхождений,\nэтикетки ↑"
C -- Z : "3: выбрать(статус = в пути) ↓\n13: setСтатус(принят) ↓"
C -- C : "7: проверитьКоличества() [брак ≤\nпоступило, сокращение < срока]\n8: [импорт без фитосанитарных\nдокументов]\nзапретитьПриёмкуПозиции()\n9: [можно принять]\nсверитьСЗаказом() [порог\nрасхождения, брак]"
C -- P : "10: [можно принять]\nсоздать(товар, склад, принято,\nгоден до = дата + срок −\nсокращение) ↓"
C -- M : "11: [можно принять]\nсоздать(приход) ↓"
C -- A : "12: [есть расхождения]\nсоздать(номер АР, позиции) ↓"
C -- SH : "14:\nзарезервироватьПредзаказы(склад)\n↓"
@enduml
