@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam classAttributeIconSize 0
skinparam wrapWidth 260
class АдаптерКасс <<control>> {
 +загрузитьПапку()
 -разобратьФайлы()
 -перенестиВProcessed()
 +ценыДляКасс()
}
class АдаптерПогоды <<control>> {
 +температуры(период)
}
class АдаптерПоставщика <<control>> {
 +отправить(заказ)
 -заказВXLSX()
}
class ВыгрузкаXLSX <<control>> {
 +файл(отчёт)
}
class КонтроллерВхода <<control>> {
 +получитьТокен(логин, пароль)
 -проверитьХэшПароля()
 -выпуститьТокен(пользователь, роль, срок)
 +сменитьПароль(текущий, новый)
}
class КонтроллерПриёмки <<control>> {
 +заказыКПриёмке()
 +принять(заказ, позиции)
 -проверитьКоличества()
 -запретитьПриёмкуПозиции()
 -сверитьСЗаказом()
}
class МоделиВременныхРядов <<control>> {
 +прогнозГруппы(ряды, алгоритм)
 -выбратьМодель()
 +оценить(кандидат, действующая)
}
class ПланировщикЗадач <<control>> {
 +расчётПрогноза()
 +загрузкаЧеков()
 +резервнаяКопия()
}
class СервисАдминистрирования <<control>> {
 +создатьПользователя(данные)
 -проверить()
 +подключитьКанал(данные)
 -новыйКлюч()
 +сохранитьПараметры(значения)
 +журналы(отбор)
}
class СервисАналитики <<control>> {
 +отчёт(...)
}
class СервисЗапасов <<control>> {
 +переместить(...)
 -проверитьМеста()
 +партии(место)
 +инвентаризация(факт по партиям)
 -проверитьФакт()
 +просроченные(место)
 +списать(...)
 -номерАкта()
 -проверитьКоличество()
}
class СервисИнтернетМагазина <<control>> {
 +зарезервироватьПредзаказы(...)
 +создатьЗаказ(канал, данные)
 -проверитьЗаказ()
 +выполнить(заказ)
}
class СервисМоделейПрогноза <<control>> {
 +создатьВерсию(параметры)
 -проверитьАлгоритм()
 +опубликовать(версия)
}
class СервисПланированияЗакупок <<control>> {
 +рассчитатьПлан(поставщик, дата)
 -ближайшаяПоставка()
 -уровеньОбслуживания()
 -квантильСпроса(α)
 -объём()
 -округлитьДоКратности()
 -дозаказатьГруппуA()
 -сократитьПоABC()
 +создатьЗаказ(план)
 +изменитьСтроки(заказ, позиции)
 -проверитьКратность()
 +перевести(...)
 -проверитьПереход()
 -проверитьРоль()
}
class СервисПрогнозирования <<control>> {
 +рассчитать(дата, по расписанию)
 -подготовитьРяды()
}
class СервисПродаж <<control>> {
 +записатьЧек(...)
 -записатьРасхождение()
}
class СервисРезервногоКопирования <<control>> {
 +создатьКопию()
}
class СервисСправочников <<control>> {
 +создатьГруппу(название)
 +создатьТовар(данные)
 -проверитьКарточку()
 +создатьПоставщика(данные)
 -проверитьСпособ()
 +создатьУсловие(...)
 +создатьСобытие(данные)
 +создатьСценарий(данные)
 -проверитьСценарий()
 +утвердитьСценарий(сценарий)
}
class СервисСроковИУценки <<control>> {
 +рекомендации(салон)
 -ожидаемыеПродажи()
 -рекомендуемаяСкидка()
 +уценить(партии, скидки)
 -проверитьСкидку()
}
АдаптерКасс -[hidden]down- ВыгрузкаXLSX
АдаптерПогоды -[hidden]down- КонтроллерВхода
АдаптерПоставщика -[hidden]down- КонтроллерПриёмки
ВыгрузкаXLSX -[hidden]down- МоделиВременныхРядов
КонтроллерВхода -[hidden]down- ПланировщикЗадач
КонтроллерПриёмки -[hidden]down- СервисАдминистрирования
МоделиВременныхРядов -[hidden]down- СервисАналитики
ПланировщикЗадач -[hidden]down- СервисЗапасов
СервисАдминистрирования -[hidden]down- СервисИнтернетМагазина
СервисАналитики -[hidden]down- СервисМоделейПрогноза
СервисЗапасов -[hidden]down- СервисПланированияЗакупок
СервисИнтернетМагазина -[hidden]down- СервисПрогнозирования
СервисМоделейПрогноза -[hidden]down- СервисПродаж
СервисПланированияЗакупок -[hidden]down- СервисРезервногоКопирования
СервисПрогнозирования -[hidden]down- СервисСправочников
СервисПродаж -[hidden]down- СервисСроковИУценки
@enduml
