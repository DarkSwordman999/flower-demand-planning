@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
node "ПК менеджера / директора\n<<device>>" as pc {
  artifact "Веб-браузер" as br
}
node "ТСД кладовщика\n<<Android>>" as tsd {
  artifact "Браузер ТСД" as br2
}
node "Сервер Компании\n<<Linux, Docker Compose>>" as app {
  component "proxy\n(Caddy, HTTPS)" as px
  component "web\n(nginx + React)" as fe
  component "api\n(FastAPI: REST API,\nинтеграции)" as be
  component "scheduler\n(APScheduler: прогноз,\nобмен, резервные копии)" as sch
  database "db\n(PostgreSQL 16)" as db
}
node "Кассы салонов\n<<ККТ>>" as kkt
node "Сервер «1С:Розница»" as c1
node "Интернет-магазин,\nмаркетплейсы" as web
node "Погодный сервис\n(Open-Meteo)" as wth
node "Почтовый сервер,\nAPI поставщиков" as mail
br --> px : HTTPS
br2 --> px : HTTPS
px --> fe : HTTP
fe --> be : REST
be --> db : SQL
sch --> db : SQL
c1 --> be : чеки (HTTP, JSON)
kkt --> c1 : чеки
web --> be : REST API (ключ канала)
sch --> web : остатки и цены (15 мин)
sch --> wth : HTTPS
be --> mail : SMTP / HTTPS (заказы)
@enduml
