@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
package "frontend/pages (экраны React)" as ui
package "api (REST API, роли доступа)" as api
package "purchasing (планирование закупок)" as pur
package "inventory, receiving, expiry\n(партии, приёмка, сроки)" as inv
package "sales, shop (продажи и онлайн-заказы)" as sal
package "forecasting, tsmodels (прогнозирование)" as fc
package "onec, weather, supplier_send, mail\n(интеграции)" as integ
package "analytics, xlsx (аналитика и отчёты)" as rep
package "models (общие сущности)" as dom
ui ..> api
api ..> pur
api ..> inv
api ..> sal
api ..> rep
api ..> integ
pur ..> fc
pur ..> inv
pur ..> integ
sal ..> inv
fc ..> sal
fc ..> integ
integ ..> sal
pur ..> dom
inv ..> dom
sal ..> dom
fc ..> dom
rep ..> dom
@enduml
