@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
package "frontend/pages\n(экраны React)" as ui
package "api\n(REST API, роли, API сайта и «1С»)" as api
package "purchasing, supplier_send\n(планирование и отправка заказов)" as pur
package "inventory, receiving, expiry\n(партии, приёмка, сроки)" as inv
package "sales, shop, onec\n(продажи, онлайн-заказы, кассы)" as sal
package "forecasting, tsmodels, weather\n(прогнозирование)" as fc
package "analytics, xlsx\n(отчёты)" as rep
package "models\n(классы-сущности)" as dom
package "scheduler, audit, security" as infra
ui ..> api
api ..> pur
api ..> inv
api ..> sal
api ..> fc
api ..> rep
api ..> infra
pur ..> fc
pur ..> inv
inv ..> sal
sal ..> inv
fc ..> dom
pur ..> dom
inv ..> dom
sal ..> dom
rep ..> dom
infra ..> fc
infra ..> sal
@enduml
