@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
package "templates, static (страницы и стили)" as ui
package "app.py (обработчики страниц)" as app
package "logic.py (FEFO, прогноз, заказ)" as logic
package "db.py, schema.sql (данные)" as dom
package "run.py, run.bat (запуск и установка)" as run
ui ..> app
app ..> logic
app ..> dom
run ..> app
@enduml
