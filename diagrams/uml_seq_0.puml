@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Сотрудник" as U
boundary "ФормаВхода" as UI
control "КонтроллерВхода" as C
entity "Пользователь" as E
entity "ЖурналАудита" as AU
U -> UI : ввести логин и пароль
UI -> C : получитьТокен(логин, пароль)
C -> E : найти(логин)
alt не найден, заблокирован или пароль неверен
  C --> UI : 401 «Неверный логин или пароль»
  UI --> U : показать ошибку
else пароль верен
  C -> C : проверитьХэшПароля()
  C -> C : выпуститьТокен(пользователь, роль, срок)
  C -> AU : записать(вход в систему)
  C --> UI : токен, роль, салон пользователя
  UI --> U : главная страница для роли
end
opt смена пароля
  U -> UI : сменить пароль
  UI -> C : сменитьПароль(текущий, новый)
  C -> E : setХэшПароля() [новый ≥ 6 символов]
end
@enduml
