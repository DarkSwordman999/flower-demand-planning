@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Флорист" as FL
boundary "receive.html\n(ФормаПриёмки)" as UI
control "receive()" as C
entity "Товар" as T
entity "Партия" as P
FL -> UI : выбрать товар, ввести количество
UI -> C : POST /receive
C -> T : получить(product_id)
alt товар не найден или количество не больше нуля
  C --> UI : сообщение об ошибке
else иначе
  C -> C : годенДо = сегодня + срокРеализации
  C -> P : создать(товар, сегодня, годенДо, кол-во, остаток = кол-во)
  C --> UI : «Принято: товар, кол-во, годен до …»
end
@enduml
