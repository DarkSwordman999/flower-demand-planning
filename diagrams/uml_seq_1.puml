@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Менеджер по закупкам" as MZ
boundary "ЭкранСправочников" as UI
control "СервисСправочников" as S
entity "ГруппаТоваров" as G
entity "Товар" as T
entity "Поставщик" as SP
entity "УсловиеПоставки" as U
entity "ЖурналАудита" as AU
MZ -> UI : добавить группу товаров
UI -> S : создатьГруппу(название)
S -> G : создать() [название уникально]
MZ -> UI : заполнить карточку товара: вид, сорт, цвет, срок реализации, кратность, штрихкод, цена
UI -> S : создатьТовар(данные)
S -> S : проверитьКарточку() [срок ≥ 1 дн., кратность ≥ 1, цена ≥ 0]
S -> T : найти(штрихкод, название)
alt такая запись уже есть
  S --> UI : «Запись с такими данными уже существует»
else данные корректны
  S -> T : создать()
end
MZ -> UI : ввести поставщика: страна, срок поставки, мин. сумма, дни заказа, способ отправки
UI -> S : создатьПоставщика(данные)
S -> S : проверитьСпособ() [email — адрес почты, api — адрес API; дни 0–6]
S -> SP : создать()
MZ -> UI : задать условие поставки: товар, цена, кратность упаковки
UI -> S : создатьУсловие(поставщик, товар, цена, кратность)
S -> U : найти(поставщик, товар)
alt условие уже есть
  S --> UI : «Условие для этого товара уже задано»
else новое
  S -> U : создать()
end
S -> AU : записать(изменение справочника)
@enduml
