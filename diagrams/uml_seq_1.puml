@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
control "ПланировщикЗадач" as SCH
control "СервисПрогнозирования" as S
entity "МодельПрогноза" as M
entity "Продажа" as PR
entity "СобытиеКалендаря" as EV
control "АдаптерПогоды" as W
control "ПодготовкаДанных" as FB
control "МоделиВременныхРядов" as TS
entity "Прогноз" as F
SCH -> S : рассчитатьПрогноз(дата) [ежедневно 03:00]
S -> M : получитьОпубликованную()
S -> PR : историяПродаж(период)
S -> EV : события(период, горизонт)
S -> W : погода(период, 14 дней)
W --> S : температура, осадки
S -> FB : построить(продажи, дни дефицита, события, погода)
FB -> FB : восстановление спроса в дни дефицита,\nкоэффициенты событий и погоды
FB --> S : подготовленные ряды
loop для каждой товарной группы (в нескольких процессах)
  loop для каждого ряда «товар — место»
    S -> TS : выбрать(ряд, кандидаты)
    TS -> TS : WAPE моделей на отложенном периоде
    TS --> S : лучшая модель, P50, ошибки
    S -> S : P80, P95 по квантилям ошибок
  end
end
S -> F : сохранить(товар, место, дата, P50, P80, P95)
S --> SCH : прогноз рассчитан
@enduml
