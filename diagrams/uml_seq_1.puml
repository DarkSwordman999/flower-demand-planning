@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Флорист" as FL
boundary "sales.html\n(ФормаПродажи)" as UI
control "sales()" as C
control "ПродажаFEFO\n(logic.sell)" as L
entity "Партия" as P
entity "Продажа" as S
FL -> UI : выбрать товар, ввести количество
UI -> C : POST /sales
C -> L : sell(товар, кол-во, сегодня)
L -> P : остаток годных партий (stock)
alt количество больше остатка
  L --> C : ошибка «Недостаточно товара: в наличии N шт.»
  C --> UI : сообщение
else иначе
  L -> P : годные партии по возрастанию срока
  loop пока не набрано количество
    L -> P : уменьшить остаток на min(нужно, остаток)
    L -> S : создать(товар, партия, дата, кол-во, цена)
  end
  L --> C : готово
  C --> UI : «Продажа записана», последние продажи
end
@enduml
