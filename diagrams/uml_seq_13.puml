@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
participant "Интернет-магазин" as WEB
boundary "APIИнтернетМагазина" as API
control "СервисИнтернетМагазина" as S
entity "КаналПродаж" as CH
entity "ОнлайнЗаказ" as O
entity "Партия" as P
entity "Резерв" as R
actor "Менеджер интернет-магазина" as SM
boundary "ЭкранОнлайнЗаказов" as UI
control "СервисПродаж" as SL
WEB -> API : передатьЗаказ(номер, дата доставки, позиции) [X-API-Key]
API -> S : создатьЗаказ(канал, данные)
S -> CH : найтиПоКлючу(SHA-256)
S -> O : найти(номер)
alt заказ с этим номером уже есть
  S --> API : прежний заказ (без дубликата)
else новый
  S -> S : проверитьЗаказ() [дата не прошла, количество > 0]
  S -> P : свободноНаДату(товар, место канала, дата доставки)
  alt товара хватает
    S -> O : создать(статус = зарезервирован)
    S -> R : зарезервировать(партии по FEFO)
  else не хватает
    S -> O : создать(статус = предзаказ)
  end
  S --> API : номер и статус
end
SM -> UI : выполнить заказ [букет собран и выдан]
UI -> S : выполнить(заказ)
S -> SL : записатьЧек(онлайн, зарезервированные партии)
S -> R : снятьРезерв()
S -> O : setСтатус(выполнен)
@enduml
