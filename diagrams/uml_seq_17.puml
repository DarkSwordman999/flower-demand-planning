@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Администратор" as AD
boundary "ЭкранАдминистрирования" as UI
control "СервисАдминистрирования" as S
entity "Пользователь" as E
entity "КаналПродаж" as CH
entity "Параметр" as PS
entity "ЖурналАудита" as AU
control "СервисРезервногоКопирования" as B
actor "Время" as TM
control "ПланировщикЗадач" as SCH
AD -> UI : добавить пользователя: логин, ФИО, роль, салон, пароль
UI -> S : создатьПользователя(данные)
S -> S : проверить() [роль, уникальный логин, пароль ≥ 6]
S -> E : создать()
AD -> UI : подключить канал продаж: код, место, коэффициент цены
UI -> S : подключитьКанал(данные)
S -> S : новыйКлюч() [показывается один раз]
S -> CH : создать(SHA-256 ключа, место, коэффициент)
AD -> UI : изменить параметры: бюджет недели, порог расхождений, скидки, горизонт прогноза
UI -> S : сохранитьПараметры(значения)
S -> PS : setЗначение() [проверка диапазонов]
S -> AU : записать(изменения)
AD -> UI : открыть журналы действий и обмена
UI -> S : журналы(отбор)
S -> AU : выбрать(отбор)
TM -> SCH : резервнаяКопия() [ежедневно 02:00]
SCH -> B : создатьКопию()
AD -> UI : создать или скачать копию
UI -> B : создатьКопию()
@enduml
