@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Менеджер по закупкам" as MZ
boundary "ЭкранПланаЗакупок" as UI
control "СервисПланированияЗакупок" as S
entity "Прогноз" as F
entity "Партия" as P
entity "УсловиеПоставки" as U
entity "ЗаказПоставщику" as Z
actor "Директор" as DIR
MZ -> UI : выбрать поставщика и дату поставки
UI -> S : сформироватьПлан(поставщик, дата)
S -> F : квантили(товары, период)
S -> P : доступныйЗапас(товары, дата)
S -> U : условия(поставщик)
S -> S : рассчитатьОбъём(), округлитьДоКратности()
alt сумма > бюджета
  S -> S : скорректироватьПоABC()
end
S -> Z : создать(статус = "Черновик", строки)
S --> UI : рекомендуемый заказ
MZ -> UI : скорректировать позиции (с причиной)
MZ -> UI : отправить на согласование
UI -> S : согласовать(заказ)
alt превышен бюджет или крупный заказ
  S -> DIR : запрос на утверждение
  DIR --> S : утверждено
end
S -> Z : setСтатус("Утверждён")
S -> Z : отправитьПоставщику()
S --> UI : заказ отправлен
@enduml
