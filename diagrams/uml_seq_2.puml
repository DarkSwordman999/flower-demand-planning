@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Владелец" as OW
boundary "order.html\n(ТаблицаЗаказа)" as UI
control "order()" as C
control "РасчётЗаказа\n(logic.order_for_supplier)" as L
entity "Поставщик" as SP
entity "Товар" as T
entity "Продажа" as S
entity "Партия" as P
OW -> UI : выбрать поставщика
UI -> C : GET /order?supplier_id=N
C -> SP : получить(N)
C -> L : order_for_supplier(поставщик, сегодня)
L -> L : период = срокПоставки + 3
L -> T : товары поставщика
loop для каждого товара
  L -> S : продажи по дням за 14 дней
  L -> L : среднее = сумма / 14
  L -> P : остаток годных партий
  L -> L : заказ = ⌈(среднее × период × 1,2 − остаток) / упаковка⌉ × упаковка
end
L --> C : период, строки заказа
C --> UI : таблица заказа и сумма
UI --> OW : заказ для передачи поставщику
@enduml
