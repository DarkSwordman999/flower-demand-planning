@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Менеджер по закупкам" as MZ
boundary "ЭкранСправочников" as UI
control "СервисСправочников" as S
entity "СобытиеКалендаря" as EV
entity "СценарийПраздника" as SC
actor "Директор" as DIR
MZ -> UI : добавить событие: дата, тип, ежегодно, коэффициент или группа акции
UI -> S : создатьСобытие(данные)
S -> EV : создать() [без коэффициента — оценка по истории]
MZ -> UI : создать сценарий праздника: дата, начало пика, последняя поставка, коэффициенты групп
UI -> S : создатьСценарий(данные)
S -> S : проверитьСценарий() [последняя поставка не позже праздника]
S -> SC : создать(утверждён = нет)
DIR -> UI : утвердить сценарий
UI -> S : утвердитьСценарий(сценарий)
S -> SC : setУтверждён(да)
S --> UI : сценарий учитывается в плане закупок
@enduml
