@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Флорист" as FL
boundary "stock.html\n(ТаблицаОстатков)" as UI
control "stock(), writeoff()" as C
control "КонтрольСроков\n(logic.batch_status)" as L
entity "Партия" as P
entity "Списание" as W
FL -> UI : открыть остатки
UI -> C : GET /
C -> P : партии с остатком по сроку годности
loop для каждой партии
  C -> L : batch_status(годенДо, сегодня)
end
C --> UI : таблица: свежая / истекает / просрочена
FL -> UI : причина, «Списать»
UI -> C : POST /writeoff/<партия>
alt причина не указана
  C --> UI : «Укажите причину списания»
else иначе
  C -> W : создать(партия, сегодня, остаток, причина)
  C -> P : остаток = 0
  C --> UI : «Партия списана»
end
@enduml
