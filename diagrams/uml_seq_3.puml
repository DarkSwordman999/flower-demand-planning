@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Время" as TM
control "ПланировщикЗадач" as SCH
control "СервисПрогнозирования" as S
entity "МодельПрогноза" as M
entity "РасчётПрогноза" as R
entity "ПродажиЗаДень" as DS
entity "ДеньДефицита" as SO
entity "СобытиеКалендаря" as EV
control "АдаптерПогоды" as W
control "МоделиВременныхРядов" as TS
entity "Прогноз" as F
TM -> SCH : расчётПрогноза() [ежедневно 03:00]
SCH -> S : рассчитать(дата, по расписанию)
S -> M : опубликованная()
S -> R : создать(статус = running)
S -> DS : ряды(история)
S -> SO : дниДефицита(история)
S -> EV : события(история, горизонт)
S -> W : температуры(период)
S -> S : подготовитьРяды() [дефицит, коэффициенты событий и погоды]
loop для каждой товарной группы (параллельно)
  S -> TS : прогнозГруппы(ряды, алгоритм)
  TS -> TS : выбратьМодель() [WAPE на отложенных днях]
  TS --> S : P50, P80, P95 по дням
end
alt расчёт успешен
  S -> F : сохранить(товар, место, день, P50, P80, P95)
  S -> R : setСтатус(ok) [рядов, время, модели]
else ошибка
  S -> R : setСтатус(failed) [действует прежний прогноз]
end
@enduml
