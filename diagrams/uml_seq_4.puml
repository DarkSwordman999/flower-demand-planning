@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Аналитик" as AN
boundary "ЭкранПрогноза" as UI
control "СервисМоделейПрогноза" as S
entity "МодельПрогноза" as M
entity "ПродажиЗаДень" as DS
control "МоделиВременныхРядов" as TS
entity "ЖурналАудита" as AU
AN -> UI : создать версию: алгоритм, отложенный период, тренд, погода
UI -> S : создатьВерсию(параметры)
S -> S : проверитьАлгоритм() [авто, сезонная наивная, Хольт–Уинтерс, Кростон]
S -> M : создать(статус = кандидат)
S -> DS : ряды(до отложенного периода)
S -> TS : оценить(кандидат, действующая) [один и тот же период]
TS --> S : WAPE и смещение обеих версий
S -> M : setМетрики(WAPE, смещение)
S -> AU : записать(создана версия)
AN -> UI : опубликовать версию
UI -> S : опубликовать(версия)
S -> TS : оценить(кандидат, действующая)
alt WAPE кандидата хуже
  S -> M : setСтатус(отклонена)
  S --> UI : «не опубликована: WAPE хуже действующей»
else не хуже
  S -> M : вАрхив(прежняя опубликованная)
  S -> M : setСтатус(опубликована)
  S --> UI : версия опубликована
end
@enduml
