@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Владелец" as OW
boundary "report.html\n(Отчёт)" as UI
control "report()" as C
entity "Продажа" as S
entity "Списание" as W
entity "Товар" as T
OW -> UI : открыть отчёт
UI -> C : GET /report
C -> S : по товарам за 30 дней:\nколичество, выручка
C -> W : по товарам за 30 дней:\nколичество, потери по цене закупки
W -> T : цена закупки
C -> C : итоги выручки и потерь
C --> UI : две таблицы и итоги
@enduml
