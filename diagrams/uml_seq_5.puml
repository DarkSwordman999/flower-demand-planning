@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Менеджер по закупкам" as MZ
boundary "ЭкранПланаЗакупок" as UI
control "СервисПланированияЗакупок" as S
entity "Поставщик" as SP
entity "УсловиеПоставки" as U
entity "Прогноз" as F
entity "Партия" as P
entity "СценарийПраздника" as SC
entity "СтрокаЗаказа" as L
entity "ЗаказПоставщику" as Z
MZ -> UI : выбрать поставщика и дату заказа
UI -> S : рассчитатьПлан(поставщик, дата)
S -> SP : графикИСрок()
S -> S : ближайшаяПоставка() [день заказа + срок поставки]
S -> U : условия(поставщик)
S -> F : p50(товары, период) [до следующей поставки]
S -> S : уровеньОбслуживания() [α = Cu / (Cu + Co)]
opt утверждённый сценарий праздника в периоде
  S -> SC : коэффициенты(группы) [в дни пика вместо календарных]
end
loop для каждого товара поставщика
  S -> S : квантильСпроса(α) [D]
  S -> P : запасДоИстеченияСрока() [S, FEFO по прогнозу]
  S -> L : заказыВПути() [Z]
  S -> S : объём() [Q = max(0, D − S − Z), не больше продаж за срок]
  S -> S : округлитьДоКратности()
end
opt сумма меньше минимальной суммы поставщика
  S -> S : дозаказатьГруппуA()
end
opt превышен бюджет недели
  S -> S : сократитьПоABC() [сначала C, затем B]
end
S --> UI : рекомендуемый заказ с обоснованием
MZ -> UI : сформировать черновик
UI -> S : создатьЗаказ(план)
S -> Z : создать(статус = черновик, строки)
MZ -> UI : изменить количество, указать причину
UI -> S : изменитьСтроки(заказ, позиции)
S -> S : проверитьКратность() [причина при отклонении > 30 %]
S -> Z : пересчитатьСумму()
@enduml
