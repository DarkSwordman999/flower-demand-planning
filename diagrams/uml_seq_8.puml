@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Кладовщик" as KL
boundary "ЭкранПриёмкиТСД" as UI
control "КонтроллерПриёмки" as C
entity "ЗаказПоставщику" as Z
entity "Партия" as P
entity "ДвижениеЗапаса" as M
entity "АктРасхождений" as A
control "СервисИнтернетМагазина" as SH
KL -> UI : выбрать заказ «в пути»
UI -> C : заказыКПриёмке()
C -> Z : выбрать(статус = в пути)
loop для каждой позиции
  KL -> UI : сканировать штрихкод, ввести поступило, брак, сокращение срока, документы
end
KL -> UI : завершить приёмку
UI -> C : принять(заказ, позиции)
C -> C : проверитьКоличества() [брак ≤ поступило, сокращение < срока]
loop для каждой строки заказа
  alt импорт без фитосанитарных документов
    C -> C : запретитьПриёмкуПозиции()
  else можно принять
    C -> C : сверитьСЗаказом() [порог расхождения, брак]
    C -> P : создать(товар, склад, принято, годен до = дата + срок − сокращение)
    C -> M : создать(приход)
  end
end
opt есть расхождения
  C -> A : создать(номер АР, позиции)
end
C -> Z : setСтатус(принят)
C -> SH : зарезервироватьПредзаказы(склад)
C --> UI : партии, акт расхождений, этикетки
@enduml
