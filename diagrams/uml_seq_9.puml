@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Кладовщик" as KL
boundary "ЭкранЗапасов" as UI
control "СервисЗапасов" as S
entity "Партия" as P
entity "ДвижениеЗапаса" as M
control "СервисИнтернетМагазина" as SH
entity "ЖурналАудита" as AU
KL -> UI : указать товар, откуда, куда и количество
UI -> S : переместить(товар, откуда, куда, количество)
S -> S : проверитьМеста() [разные, существуют]
S -> P : доступно(товар, откуда)
alt не хватает
  S --> UI : «Недостаточно товара: доступно N»
else хватает
  S -> P : списатьПоFEFO(откуда, количество)
  S -> M : создать(перемещение, расход)
  S -> P : создать(куда, тот же срок и себестоимость, исходная партия)
  S -> M : создать(перемещение, приход)
  S -> AU : записать(перемещение товара)
  S -> SH : зарезервироватьПредзаказы(куда)
  S --> UI : созданные партии
end
@enduml
