@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
[*] --> Ожидается : заказ отправлен
Ожидается --> НаПриёмке : поставка прибыла
НаПриёмке --> ВПродаже : оприходована
НаПриёмке --> Возврат : брак (полностью)
state ВПродаже {
  [*] --> Свежая
  Свежая --> СрокИстекает : до «годен до» ≤ 2 дней
  СрокИстекает --> Уценена : уценка подтверждена
}
ВПродаже --> Продана : остаток = 0
ВПродаже --> Списана : потеря товарного вида
Уценена --> Списана : срок истёк
Продана --> [*]
Списана --> [*]
Возврат --> [*]
@enduml
