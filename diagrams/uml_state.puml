@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
[*] --> Свежая : поставка принята
Свежая --> СрокИстекает : до «годен до» ≤ 2 дней
СрокИстекает --> Просрочена : срок прошёл
Свежая --> Продана : остаток = 0
СрокИстекает --> Продана : остаток = 0
Свежая --> Списана : списание
СрокИстекает --> Списана : списание
Просрочена --> Списана : списание
Продана --> [*]
Списана --> [*]
@enduml
