@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
actor "Менеджер\nпо закупкам" as MZ
actor "Кладовщик" as KL
actor "Продавец-\nфлорист" as PF
actor "Менеджер\nинтернет-магазина" as SM
actor "Директор" as DIR
actor "Аналитик" as AN
actor "Администратор" as AD
actor "Время" as TM
actor "«1С:Розница»,\nкассы" as C1 <<system>>
actor "Интернет-магазин,\nканалы продаж" as WEB <<system>>
actor "Поставщик" as SUP <<system>>
actor "Погодный сервис" as WS <<system>>
rectangle "ИС планирования закупок и продаж цветов" {
  usecase "Войти в систему" as U0
  usecase "Вести номенклатуру\nи поставщиков" as U1
  usecase "Вести календарь\nи сценарии праздников" as U3
  usecase "Построить прогноз\nспроса" as U4
  usecase "Обновить версию\nмодели прогноза" as U5
  usecase "Сформировать план\nзакупок" as U6
  usecase "Согласовать заказ\nпоставщику" as U8
  usecase "Отправить заказ\nи отследить поставку" as U9
  usecase "Принять поставку" as U10
  usecase "Переместить товар" as U11
  usecase "Провести\nинвентаризацию" as U12
  usecase "Продать товар\nв салоне" as U13
  usecase "Обменяться данными\nс «1С» и кассами" as U14
  usecase "Обработать\nонлайн-заказ" as U15
  usecase "Уценить партии" as U17
  usecase "Списать партии" as U18
  usecase "Сформировать\nаналитический отчёт" as U19
  usecase "Администрировать\nсистему" as U20
}
MZ --> U1
MZ --> U3
MZ --> U6
MZ --> U9
DIR --> U8
DIR --> U19
AN --> U4
AN --> U5
AN --> U19
TM --> U4
TM --> U14
KL --> U10
KL --> U11
KL --> U12
KL --> U18
PF --> U13
PF --> U17
PF --> U18
SM --> U15
AD --> U20
U4 --> WS
C1 --> U14
WEB --> U15
U9 --> SUP
U8 .> U6 : <<extend>>
@enduml
