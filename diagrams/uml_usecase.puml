@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
actor "Флорист-\nкассир" as FL
actor "Владелец\nсалона" as OW
rectangle "ФлораПлан Базовая" {
  usecase "Войти в систему" as U0
  usecase "Принять поставку" as U1
  usecase "Продать товар" as U2
  usecase "Просмотреть остатки\nи сроки партий" as U3
  usecase "Списать партию" as U4
  usecase "Вести товары\nи поставщиков" as U5
  usecase "Просмотреть прогноз\nспроса" as U6
  usecase "Рассчитать заказ\nпоставщику" as U7
  usecase "Рассчитать средние\nпродажи" as U9
  usecase "Сформировать отчёт\nза 30 дней" as U8
}
OW --|> FL
FL --> U1
FL --> U2
FL --> U3
OW --> U5
OW --> U6
OW --> U7
OW --> U8
U4 .> U3 : <<extend>>
U6 ..> U9 : <<include>>
U7 ..> U9 : <<include>>
U1 ..> U0 : <<include>>
U2 ..> U0 : <<include>>
U7 ..> U0 : <<include>>
@enduml
