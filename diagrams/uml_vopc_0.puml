@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class ЭкранПриёмкиТСД <<boundary>> {
 +сканировать()
 +ввестиКоличество()
 +завершить()
}
class КонтроллерПриёмки <<control>> {
 +открытьПриёмку(заказ)
 +зафиксировать(позиция)
 +завершить()
 -сверитьСЗаказом()
}
class ЗаказПоставщику <<entity>> {
 номер
 дата
 статус
 +получитьСтроки()
}
class Товар <<entity>> {
 наименование
 срокРеализации
 кратность
}
class Партия <<entity>> {
 датаПоступления
 годенДо
 количество
 остаток
}
class АктРасхождений <<entity>> {
 дата
 позиции
}
ЭкранПриёмкиТСД --> КонтроллерПриёмки
КонтроллерПриёмки --> ЗаказПоставщику
КонтроллерПриёмки --> Партия
КонтроллерПриёмки --> АктРасхождений
Товар "1" -- "0..*" Партия
ЗаказПоставщику "1" -- "0..*" Партия
@enduml
