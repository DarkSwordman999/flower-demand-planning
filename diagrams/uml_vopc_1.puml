@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class ПланировщикЗадач <<control>>
class СервисПрогнозирования <<control>> {
 +рассчитатьПрогноз(дата)
 +оценитьТочность(период)
}
class ПостроительПризнаков <<control>> {
 +построить(продажи, события, погода)
}
class АдаптерПогоды <<control>> {
 +прогнозПогоды(дни)
}
class МодельПрогноза <<entity>> {
 версия
 алгоритм
 WAPE
 статус
 +predict()
}
class Прогноз <<entity>> {
 дата
 P50
 P80
 P95
}
class Продажа <<entity>>
class СобытиеКалендаря <<entity>> {
 дата
 тип
}
ПланировщикЗадач --> СервисПрогнозирования
СервисПрогнозирования --> ПостроительПризнаков
СервисПрогнозирования --> АдаптерПогоды
СервисПрогнозирования --> МодельПрогноза
СервисПрогнозирования --> Прогноз
ПостроительПризнаков --> Продажа
ПостроительПризнаков --> СобытиеКалендаря
МодельПрогноза "1" -- "0..*" Прогноз
@enduml
