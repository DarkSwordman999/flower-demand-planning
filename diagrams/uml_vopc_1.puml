@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class ПланировщикЗадач <<control>>
class СервисПрогнозирования <<control>> {
 +рассчитатьПрогноз(дата)
 +оценитьТочность(период)
}
class ПодготовкаДанных <<control>> {
 +построить(продажи, события, погода)
}
class АдаптерПогоды <<control>> {
 +погода(период, дни)
}
class МоделиВременныхРядов <<control>> {
 +сезоннаяНаивная()
 +хольтУинтерс()
 +кростон()
 +выбрать(ряд, кандидаты)
}
class МодельПрогноза <<entity>> {
 версия
 алгоритм
 WAPE
 статус
 +рассчитать()
}
class Прогноз <<entity>> {
 дата
 P50
 P80
 P95
}
class Продажа <<entity>>
class СобытиеКалендаря <<entity>> {
 дата
 тип
}
ПланировщикЗадач --> СервисПрогнозирования
СервисПрогнозирования --> ПодготовкаДанных
СервисПрогнозирования --> АдаптерПогоды
СервисПрогнозирования --> МодельПрогноза
СервисПрогнозирования --> МоделиВременныхРядов
СервисПрогнозирования --> Прогноз
ПодготовкаДанных --> Продажа
ПодготовкаДанных --> СобытиеКалендаря
МодельПрогноза "1" -- "0..*" Прогноз
@enduml
