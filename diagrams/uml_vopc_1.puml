@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class ФормаПродажи <<boundary>> {
 товар
 количество
}
class ОбработчикПродаж <<control>> {
 +sales()
}
class ПродажаFEFO <<control>> {
 +sell(товар, кол-во, дата)
 +stock(товар, дата)
}
class Товар <<entity>> {
 цена
}
class Партия <<entity>> {
 годенДо
 остаток
}
class Продажа <<entity>> {
 дата
 количество
 цена
}
ФормаПродажи --> ОбработчикПродаж
ОбработчикПродаж --> ПродажаFEFO
ПродажаFEFO --> Товар
ПродажаFEFO --> Партия
ПродажаFEFO --> Продажа
Партия "1" -- "0..*" Продажа
@enduml
